# Neon: the dev database and a separate test database (tests truncate every table).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/artiko?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/artiko_test?sslmode=require
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
EMBED_PROVIDER=clip
# Seconds between index database refreshes on scans; zero refreshes every scan.
SCAN_INDEX_REFRESH_SECONDS=15
PUBLIC_WEB_URL=http://localhost:3000
# Uploads: Neon Object Storage bucket (empty MEDIA_BUCKET = local disk in MEDIA_DIR).
MEDIA_BUCKET=
AWS_ENDPOINT_URL_S3=https://BRANCH.storage.c-N.REGION.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Signs the short-lived links to reviewer-only proof files (generate a long random string; empty = no private link).
PROOF_URL_SECRET=
# Copy detection when publishing: CLIP cosine similarity and pHash bit distance (of 64) that refuse a work.
PUBLISH_DUPLICATE_THRESHOLD=0.92
PUBLISH_PHASH_MAX_DISTANCE=8
# Signs the nonces phones put into their key attestation (long random string; empty = devices cannot register).
NONCE_SECRET=
# "chain" checks the Android Key Attestation chain against Google's roots; "none" accepts any chain (tests, demo only).
ATTESTATION_PROVIDER=chain
# Play Integrity: only "none" exists yet (it passes every token except "fail").
INTEGRITY_PROVIDER=none
# A signed capture must reach the server within this many minutes of being taken.
CAPTURE_MAX_AGE_MINUTES=10
# Transition: true (the default) lets imported proof files count for the badge until the app ships in-app
# capture. Set false to enforce the rule: only verified in-app captures count.
# Either way, proofs must differ from the work and from each other to count (SHA-256, and pHash for images).
ALLOW_IMPORTED_PROOFS_FOR_BADGE=true
# Header your proxy overwrites with the real client IP, used by the rate limits. Empty = the socket peer
# (fine locally). On Render: CF-Connecting-IP. Never a header a client can send, such as X-Forwarded-For.
CLIENT_IP_HEADER=
# Redis URL shared by all API instances. Empty = process-local request counters.
RATE_LIMIT_REDIS_URL=
